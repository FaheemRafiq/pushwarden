<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>PushWarden</title>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <!-- per user: no administrator password -->
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="default">
            <line choice="com.pushwarden.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.pushwarden.pkg" visible="false">
        <pkg-ref id="com.pushwarden.pkg"/>
    </choice>
    <pkg-ref id="com.pushwarden.pkg" version="@VERSION@" onConclusion="none">pushwarden-component.pkg</pkg-ref>
</installer-gui-script>
